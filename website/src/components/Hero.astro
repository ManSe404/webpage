---
import { Image } from 'astro:assets';
import profile from '../data/profile.json';
import { withBase } from '../lib/url';
import portrait from '../assets/portrait.jpg';
import EcgTrace from './EcgTrace.astro';
import NodeField from './NodeField.astro';
---

<section class="hero" id="home">
  <NodeField />

  <div class="hero-inner wrap">
    <div class="hero-copy">
      <p class="eyebrow">{profile.headline}</p>

      <h1>
        <span class="hero-name">{profile.name}</span>
      </h1>

      <p class="hero-tagline">{profile.tagline}</p>
      <p class="hero-summary">{profile.summary}</p>

      <div class="hero-actions">
        <a class="btn" href={withBase('/#work')}>
          View work
          <span aria-hidden="true">→</span>
        </a>
        <a class="btn btn-ghost" href={withBase(profile.cv)} download>Download CV</a>
      </div>
    </div>

    <div class="hero-portrait">
      <div class="portrait-frame">
        <Image
          src={portrait}
          alt={`Portrait of ${profile.name}`}
          widths={[340, 680]}
          sizes="(max-width: 900px) 74vw, 340px"
          format="webp"
          quality={78}
          loading="eager"
        />
      </div>
      <div class="portrait-ring" aria-hidden="true"></div>
    </div>
  </div>

  <div class="hero-ecg wrap">
    <EcgTrace height={128} />
  </div>

  <div class="hero-stats wrap">
    {profile.stats.map((stat) => (
      <div class="stat">
        <span class="stat-value mono" data-count-to={stat.value} data-suffix={stat.suffix}>
          0{stat.suffix}
        </span>
        <span class="stat-label">{stat.label}</span>
      </div>
    ))}
  </div>
</section>

<script>
  // Count-up for the hero stats, triggered once the row scrolls into view.
  const counters = document.querySelectorAll<HTMLElement>('[data-count-to]');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const run = (el: HTMLElement) => {
    const target = Number(el.dataset.countTo ?? 0);
    const suffix = el.dataset.suffix ?? '';

    if (reduced) {
      el.textContent = `${target}${suffix}`;
      return;
    }

    const duration = 1400;
    const started = performance.now();

    const step = (now: number) => {
      const progress = Math.min((now - started) / duration, 1);
      // easeOutExpo — fast start, long settle.
      const eased = progress === 1 ? 1 : 1 - Math.pow(2, -10 * progress);
      el.textContent = `${Math.round(target * eased)}${suffix}`;
      if (progress < 1) requestAnimationFrame(step);
    };

    requestAnimationFrame(step);
  };

  if ('IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          run(entry.target as HTMLElement);
          observer.unobserve(entry.target);
        }
      },
      { threshold: 0.6 },
    );
    counters.forEach((el) => observer.observe(el));
  } else {
    counters.forEach(run);
  }
</script>

<style>
  .hero {
    position: relative;
    padding-top: clamp(3rem, 9vh, 6rem);
    padding-bottom: clamp(2.5rem, 6vh, 4rem);
    overflow: hidden;
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 0.85fr);
    gap: clamp(2rem, 6vw, 4.5rem);
    align-items: center;
  }

  .hero-copy {
    display: flex;
    flex-direction: column;
    gap: 1.35rem;
    animation: rise 0.9s var(--ease) both;
  }

  .hero-name {
    display: block;
    background: linear-gradient(120deg, var(--text) 18%, var(--bio) 58%, var(--ai) 96%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .hero-tagline {
    font-size: clamp(1.1rem, 2.2vw, 1.42rem);
    color: var(--text);
    font-weight: 500;
    max-width: 34ch;
    text-wrap: balance;
  }

  .hero-summary {
    color: var(--text-dim);
    max-width: 56ch;
    font-size: 1.01rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 0.35rem;
  }

  /* --- Portrait ---------------------------------------------------------- */

  .hero-portrait {
    position: relative;
    justify-self: center;
    width: min(100%, 340px);
    aspect-ratio: 4 / 5;
    animation: rise 0.9s var(--ease) 0.15s both;
  }

  .portrait-frame {
    position: absolute;
    inset: 0;
    border-radius: 140px 140px var(--radius) var(--radius);
    overflow: hidden;
    border: 1px solid var(--border-strong);
    background: var(--bg-raised);
  }

  .portrait-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 18%;
    filter: grayscale(0.55) contrast(1.06);
    transition: filter 0.6s var(--ease), transform 0.6s var(--ease);
  }

  .hero-portrait:hover .portrait-frame img {
    filter: grayscale(0) contrast(1);
    transform: scale(1.03);
  }

  /* Rotating conic halo behind the portrait. */
  .portrait-ring {
    position: absolute;
    inset: -14%;
    border-radius: 50%;
    background: conic-gradient(
      from 0deg,
      transparent 0deg,
      var(--glow-bio) 70deg,
      transparent 150deg,
      var(--glow-ai) 250deg,
      transparent 330deg
    );
    filter: blur(38px);
    opacity: 0.5;
    z-index: -1;
    animation: spin 17s linear infinite;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  @keyframes rise {
    from { opacity: 0; transform: translateY(26px); }
    to { opacity: 1; transform: none; }
  }

  /* --- ECG band ---------------------------------------------------------- */

  .hero-ecg {
    position: relative;
    z-index: 1;
    margin-top: clamp(2rem, 5vh, 3.5rem);
  }

  /* --- Stats ------------------------------------------------------------- */

  .hero-stats {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
    padding-top: clamp(1.5rem, 4vh, 2.5rem);
    border-top: 1px solid var(--border);
  }

  .stat {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .stat-value {
    font-size: clamp(1.8rem, 3.6vw, 2.6rem);
    font-weight: 500;
    line-height: 1;
    color: var(--bio);
    text-shadow: 0 0 26px var(--glow-bio);
  }

  .stat-label {
    font-size: 0.83rem;
    color: var(--text-faint);
    letter-spacing: 0.01em;
  }

  @media (max-width: 900px) {
    .hero-inner {
      grid-template-columns: 1fr;
    }

    .hero-portrait {
      order: -1;
      width: min(74%, 260px);
    }

    .hero-stats {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.5rem 1rem;
    }
  }
</style>
