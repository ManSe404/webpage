---
import { withBase } from '../lib/url';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { title, category, summary, featured, org, client, period } = project.data;

// "404 Solutions · with Provectus · 2024 — Present": the partner and the period
// only appear when the project file has them. Each part stays on one line, so a
// line only breaks after a separator, never inside "2023 — 2024"; on desktop
// the period takes a line of its own.
const context = [
  ...(org ? [{ text: org, when: false }] : []),
  ...(client ? [{ text: `with ${client}`, when: false }] : []),
  ...(period ? [{ text: period, when: true }] : []),
];
---

<a class="row" href={withBase(`/projects/${project.id}/`)}>
  <div class="row-topic">
    <span class="chip chip-ai">{category}</span>
  </div>

  <div class="row-main">
    <div class="row-head">
      <h2 class="row-title">{title}</h2>
      {featured && <span class="chip chip-bio row-tag">On homepage</span>}
    </div>
    <p class="row-summary">{summary}</p>
  </div>

  {context.length > 0 && (
    <p class="row-context mono">
      {context.map((part, index) => (
        <Fragment>{index > 0 && <span class:list={['sep', { 'sep-when': part.when }]}>{'\u00a0· '}</span>}<span class:list={['part', { when: part.when }]}>{part.text}</span></Fragment>
      ))}
    </p>
  )}

  <span class="row-arrow" aria-hidden="true">→</span>
</a>

<style>
  /* Phone first: one column, the arrow shares the top line with the topic chip
     so it does not cost a line of its own. */
  .row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas:
      'topic arrow'
      'main main'
      'context context';
    gap: 0.6rem 1rem;
    padding: 1.2rem 0;
    border-bottom: 1px solid var(--border);
    transition: background 0.3s var(--ease);
  }

  .row:focus-visible {
    outline-offset: -2px;
    border-radius: var(--radius-sm);
  }

  .row-topic {
    grid-area: topic;
    display: flex;
    align-items: center;
    min-width: 0;
  }

  /* The global chip is 0.71rem; the page keeps every text at 12px or more. */
  .chip {
    font-size: 0.75rem;
  }

  .row-main {
    grid-area: main;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    min-width: 0;
  }

  .row-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 0.7rem;
  }

  .row-title {
    font-size: 1.15rem;
    line-height: 1.3;
    letter-spacing: -0.015em;
    color: var(--text);
    transition: color 0.3s var(--ease);
  }

  .row-tag {
    padding-block: 0.12rem;
  }

  .row-summary {
    color: var(--text-dim);
    font-size: 0.95rem;
    line-height: 1.55;
  }

  .row-context {
    grid-area: context;
    font-size: 0.8rem;
    line-height: 1.5;
    letter-spacing: 0.02em;
    color: var(--text-faint);
  }

  .part {
    white-space: nowrap;
  }

  .row-arrow {
    grid-area: arrow;
    align-self: center;
    font-size: 1.1rem;
    line-height: 1;
    color: var(--bio);
    transition: transform 0.3s var(--ease);
  }

  /* Hover only where there is a pointer that hovers, so a tap on a phone does
     not leave a row stuck in its hover colour. */
  @media (hover: hover) {
    .row:hover .row-title {
      color: var(--bio);
    }

    .row:hover .row-arrow {
      transform: translateX(4px);
    }
  }

  /* Desktop: the topic gets its own column and the summary is clamped to two
     lines so the list stays scannable. The full text stays in the DOM, so
     screen readers and the detail page still get all of it. Below 1120px the
     context sits under the summary, so the summary keeps a readable width. */
  @media (min-width: 900px) {
    .row {
      grid-template-columns: 11rem minmax(0, 1fr) 1.5rem;
      grid-template-areas:
        'topic main arrow'
        'topic context arrow';
      align-items: start;
      gap: 0.45rem 2rem;
      padding: 1.35rem 0.75rem;
    }

    .row-topic {
      padding-top: 0.2rem;
    }

    .row-title {
      font-size: 1.2rem;
    }

    .row-summary {
      display: -webkit-box;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 2;
      line-clamp: 2;
      overflow: hidden;
    }

    .row-arrow {
      align-self: start;
      padding-top: 0.3rem;
      text-align: right;
    }
  }

  /* Wide: topic | title and summary | context | arrow, the period on a line
     of its own under who the work was for. */
  @media (min-width: 1120px) {
    .row {
      grid-template-columns: 11rem minmax(0, 1fr) 16rem 1.5rem;
      grid-template-areas: 'topic main context arrow';
      row-gap: 0;
    }

    .row-context {
      padding-top: 0.25rem;
      letter-spacing: 0;
    }

    .sep-when {
      display: none;
    }

    .when {
      display: block;
    }
  }

  /* The row only lights up in the desktop layout, where it has inline padding
     for the background to sit in. */
  @media (min-width: 900px) and (hover: hover) {
    .row:hover {
      background: var(--surface-hover);
    }
  }
</style>
