---
// The panels behind the honeycomb cells. With JavaScript one is shown at a
// time (the script in HiveDashboard opens and closes them); without it every
// panel shows, one under the other, so nothing is out of reach.
import { getCollection } from 'astro:content';
import { withBase } from '../../lib/url';
import consultancy from '../../data/consultancy.json';
import skills from '../../data/skills.json';
import type { NowItem } from '../../lib/dashboard';
import JourneyBoard from './JourneyBoard.astro';
import ProjectDetails from './ProjectDetails.astro';
import { attribution } from '../../lib/dashboard';

interface Props {
  data: {
    projectCount: number;
    research: { works: number; citations: number; h: number; firstAuthor: number; top: { year: number; title: string; venue: string; citations: number; url?: string }[] };
    education: { degrees: { degree: string; institution: string; period?: string }[]; certifications: { name: string; issuer: string }[]; memberships: string[] };
    tools: { name: string; count: number }[];
    now: NowItem[];
    consultancy: { projects: number; partners: { name: string; count: number }[]; summary?: string };
    profile: { email: string; cv: string; links: Record<string, string> };
  };
}

const { data } = Astro.props;
const maxTool = data.tools[0]?.count ?? 1;
const groups = (['Leading', 'Studying', 'Building'] as const)
  .map((kind) => ({ kind, items: data.now.filter((n) => n.kind === kind) }))
  .filter((g) => g.items.length);
const plural = (n: number, one: string, many = `${one}s`) => `${n} ${n === 1 ? one : many}`;

// Partners: the counts come from the projects, the descriptions from
// collaborations.json where a partner has one ("Provectus" ~ "Provectus Inc").
const collaborations = (await getCollection('collaborations')).map((c) => c.data);
// The Projects panel: projects with a `featured` position, in that order.
const featured = (await getCollection('projects')).filter((p) => p.data.featured).sort((a, b) => (a.data.featured ?? 0) - (b.data.featured ?? 0));
const partners = data.consultancy.partners.map((p) => ({
  ...p,
  about: collaborations.find((c) => c.name.toLowerCase().startsWith(p.name.toLowerCase())),
}));
---

<div class="hive-panels card" data-hive-panels>
  <button class="panel-close mono" type="button" data-close hidden aria-label="Close panel">Close ✕</button>

  <section class="panel" id="hive-projects" data-panel="projects" aria-label="Featured projects">
    <p class="panel-title">Featured projects</p>
    <ol class="items">
      {featured.map((p, i) => (
        <li>
          <details class="item" name="hive-projects">
            <summary>
              <span class="item-no mono">{String(i + 1).padStart(2, '0')}</span>
              <span class="item-head"><span class="item-title">{p.data.title}</span><span class="item-meta">{attribution(p)} · {p.data.category}</span></span>
            </summary>
            <div class="item-body"><ProjectDetails project={p} showTitle={false} /></div>
          </details>
        </li>
      ))}
    </ol>
    <a class="panel-more mono" href={withBase('/projects/')}>All {data.projectCount} projects →</a>
  </section>

  <section class="panel" id="hive-experience" data-panel="experience" aria-label="Career and education">
    <p class="panel-title">Career and education</p>
    <JourneyBoard />
    <a class="panel-more mono" href={withBase(data.profile.cv)} download>Full CV (PDF) →</a>
  </section>

  <section class="panel" id="hive-research" data-panel="research" aria-label="Research">
    <p class="panel-title">Research</p>
    <dl class="figures">
      <div><dt>Works</dt><dd class="mono">{data.research.works}</dd></div>
      <div><dt>Citations</dt><dd class="mono">{data.research.citations}</dd></div>
      <div><dt>h-index</dt><dd class="mono">{data.research.h}</dd></div>
      <div><dt>First author</dt><dd class="mono">{data.research.firstAuthor}</dd></div>
    </dl>
    <p class="panel-sub">Most cited</p>
    <ol class="papers">
      {data.research.top.map((p) => (
        <li>
          <span class="mono paper-meta">{p.year} · {plural(p.citations, 'citation')}</span>
          {p.url ? <a href={p.url} target="_blank" rel="noopener">{p.title}</a> : <span>{p.title}</span>}
          <span class="paper-venue">{p.venue}</span>
        </li>
      ))}
    </ol>
    <a class="panel-more mono" href={withBase('/research/')}>All publications →</a>
  </section>

  <section class="panel" id="hive-education" data-panel="education" aria-label="Education">
    <p class="panel-title">Education</p>
    <ul class="rows">
      {data.education.degrees.map((d) => (
        <li><strong>{d.degree}</strong><span>{d.institution}{d.period && ` · ${d.period}`}</span></li>
      ))}
    </ul>
    <p class="panel-sub">Certifications</p>
    <div class="chips">{data.education.certifications.map((c) => <span class="chip">{c.name}</span>)}</div>
    <p class="panel-note">{plural(data.education.memberships.length, 'professional membership')}</p>
    <a class="panel-more mono" href={withBase(data.profile.cv)} download>Full CV (PDF) →</a>
  </section>

  <section class="panel" id="hive-toolkit" data-panel="toolkit" aria-label="Tools">
    <p class="panel-title">Most used tools, counted from the projects</p>
    <ul class="bars">
      {data.tools.map((t) => (
        <li>
          <span class="bar-name">{t.name}</span>
          <span class="bar-track" aria-hidden="true"><span class="bar-fill" style={`width:${Math.round((t.count / maxTool) * 100)}%`}></span></span>
          <span class="bar-count mono">{plural(t.count, 'project')}</span>
        </li>
      ))}
    </ul>
    <p class="panel-sub">Skills</p>
    <dl class="skills">
      {skills.map((g) => (<div><dt>{g.group}</dt><dd>{g.items.join(' · ')}</dd></div>))}
    </dl>
  </section>

  <section class="panel" id="hive-roadmap" data-panel="roadmap" aria-label="In progress now">
    <p class="panel-title">In progress now</p>
    <div class="groups">
      {groups.map((g) => (
        <div>
          <p class="panel-sub">{g.kind}</p>
          <ul class="rows">{g.items.map((n) => <li><strong>{n.title}</strong><span>{n.detail}</span></li>)}</ul>
        </div>
      ))}
    </div>
  </section>

  <section class="panel" id="hive-consultancy" data-panel="consultancy" aria-label="404 Solutions">
    <p class="panel-title">404 Solutions</p>
    {data.consultancy.summary && <p class="step-text">{data.consultancy.summary}</p>}
    <p class="panel-sub">What it delivers</p>
    <ol class="items">
      {consultancy.services.map((s, i) => (
        <li>
          <details class="item" name="hive-services">
            <summary>
              <span class="item-no mono">{String(i + 1).padStart(2, '0')}</span>
              <span class="item-head"><span class="item-title">{s.title}</span><span class="item-meta">{s.area} · with {s.deliveredWith.join(' · ')}</span></span>
            </summary>
            <div class="item-body"><p class="step-text">{s.description}</p></div>
          </details>
        </li>
      ))}
    </ol>
    <p class="panel-sub">{plural(data.consultancy.projects, 'project')} with</p>
    <ol class="items">
      {partners.map((p) => (
        <li>
          <details class="item" name="hive-partners">
            <summary>
              <span class="item-head"><span class="item-title">{p.about?.name ?? p.name}</span><span class="item-meta">{[p.about?.kind, p.about?.location, plural(p.count, 'project')].filter(Boolean).join(' · ')}</span></span>
            </summary>
            {p.about && <div class="item-body"><p class="step-text">{p.about.description}</p></div>}
          </details>
        </li>
      ))}
    </ol>
    <a class="panel-more mono" href={withBase('/#contact')}>Work with me →</a>
  </section>

  <section class="panel" id="hive-contact" data-panel="contact" aria-label="Contact">
    <p class="panel-title">Get in touch</p>
    <div class="panel-links">
      <a class="btn" href={`mailto:${data.profile.email}`}>Email</a>
      <a class="btn btn-ghost" href={data.profile.links.linkedin} target="_blank" rel="noopener">LinkedIn</a>
      <a class="btn btn-ghost" href={data.profile.links.github} target="_blank" rel="noopener">GitHub</a>
      <a class="btn btn-ghost" href={withBase(data.profile.cv)} download>CV (PDF)</a>
    </div>
  </section>
</div>

<style>
  .hive-panels { position: relative; margin-top: 1.4rem; padding: clamp(1.1rem, 2.5vw, 1.6rem); }
  .hive-panels:not([hidden]) .panel + .panel { margin-top: 1.6rem; padding-top: 1.6rem; border-top: 1px solid var(--border); }
  .panel[hidden], .hive-panels[hidden] { display: none; }
  .panel-close {
    position: absolute; top: 0.8rem; right: 0.8rem; min-height: 32px; padding: 0 0.7rem;
    font-size: 0.75rem; color: var(--text-dim); background: transparent;
    border: 1px solid var(--border); border-radius: var(--radius-sm); cursor: pointer;
  }
  .panel-close:hover { color: var(--text); border-color: var(--border-strong); }

  .panel-title { margin: 0 0 0.9rem; padding-right: 5.5rem; font-size: 0.8rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--bio); }
  .panel-sub { margin: 1.1rem 0 0.5rem; font-size: 0.75rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-faint); }
  .panel-note { margin: 0.8rem 0 0; font-size: 0.85rem; color: var(--text-dim); }
  .panel-more { display: inline-block; margin-top: 1rem; font-size: 0.8rem; color: var(--bio); text-decoration: none; }
  .panel-more:hover { text-decoration: underline; }
  .panel-links { display: flex; flex-wrap: wrap; gap: 0.7rem 1.4rem; align-items: center; }

  .items { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--border); }
  .items > li { border-bottom: 1px solid var(--border); }
  .item summary {
    display: flex; align-items: baseline; gap: 0.9rem; padding: 0.75rem 2.2rem 0.75rem 0.2rem;
    position: relative; cursor: pointer; list-style: none;
  }
  .item summary::-webkit-details-marker { display: none; }
  .item summary::after {
    content: '+'; position: absolute; right: 0.4rem; top: 0.7rem;
    font-family: var(--font-mono); font-size: 1rem; color: var(--text-faint);
  }
  .item[open] summary::after { content: '−'; color: var(--bio); }
  .item summary:hover .item-title, .item[open] .item-title { color: var(--bio); }
  .item summary:focus-visible { outline: 1px dashed var(--border-strong); outline-offset: 2px; }
  .item-no { flex: none; font-size: 0.75rem; color: var(--bio); }
  .item-head { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.2rem 0.9rem; }
  .item-title { font-weight: 600; transition: color 0.2s var(--ease); }
  .item-meta { font-size: 0.85rem; color: var(--text-dim); }
  .item-body { padding: 0 0.2rem 1rem 2.3rem; }

  .step-meta { margin: 0 0 0.35rem; font-size: 0.75rem; color: var(--bio); letter-spacing: 0.04em; }
  .step-title { margin: 0 0 0.4rem; font-size: clamp(1.25rem, 2.2vw, 1.55rem); line-height: 1.2; }
  .step-org { margin: 0 0 0.6rem; color: var(--text-dim); }
  .step-result {
    display: flex; gap: 0.7rem; align-items: baseline; margin: 0.6rem 0; padding: 0.6rem 0.8rem;
    border-left: 2px solid var(--bio); background: var(--surface); color: var(--text);
  }
  .step-result .mono { font-size: 0.75rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--bio); flex: none; }
  .step-text { margin: 0 0 0.8rem; color: var(--text-dim); max-width: 62rem; }
  .step-list { margin: 0 0 0.8rem; padding-left: 1.1rem; color: var(--text-dim); }
  .step-list li + li { margin-top: 0.3rem; }
  .step-link { display: inline-block; margin-top: 0.8rem; font-size: 0.8rem; color: var(--bio); text-decoration: none; }

  .figures { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0.8rem; margin: 0; }
  .figures div { padding: 0.7rem 0.8rem; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-sm); }
  .figures dt { font-size: 0.75rem; color: var(--text-faint); text-transform: uppercase; letter-spacing: 0.06em; }
  .figures dd { margin: 0.2rem 0 0; font-size: 1.5rem; color: var(--bio); }

  .papers { margin: 0; padding-left: 1.2rem; display: grid; gap: 0.7rem; }
  .papers li { display: grid; gap: 0.15rem; }
  .papers a, .papers span { color: var(--text); }
  .paper-meta { font-size: 0.75rem; color: var(--bio) !important; }
  .paper-venue { font-size: 0.85rem; color: var(--text-dim) !important; }

  .rows { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.55rem; }
  .rows li { display: grid; gap: 0.1rem; }
  .rows span { font-size: 0.85rem; color: var(--text-dim); }
  .skills { margin: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(16rem, 100%), 1fr)); gap: 0.7rem 1.6rem; }
  .skills dt { font-size: 0.8rem; font-weight: 600; color: var(--text); }
  .skills dd { margin: 0.15rem 0 0; font-size: 0.85rem; color: var(--text-dim); line-height: 1.5; }
  .groups { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(15rem, 100%), 1fr)); gap: 0 1.6rem; }
  .groups .panel-sub:first-child { margin-top: 0; }

  .bars { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.45rem; }
  .bars li { display: grid; grid-template-columns: minmax(7rem, 11rem) 1fr auto; gap: 0.8rem; align-items: center; }
  .bar-name { font-size: 0.9rem; }
  .bar-track { height: 8px; background: var(--surface-hover); border-radius: 4px; overflow: hidden; }
  .bar-fill { display: block; height: 100%; background: linear-gradient(90deg, var(--bio-dim), var(--bio)); border-radius: 4px; }
  .bar-count { font-size: 0.75rem; color: var(--text-faint); }

  @media (max-width: 640px) {
    .figures { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .bars li { grid-template-columns: 1fr auto; }
    .bar-track { grid-column: 1 / -1; grid-row: 2; }
    .item-body { padding-left: 0.2rem; }
  }
</style>
