---
import profile from '../data/profile.json';
import { withBase } from '../lib/url';
import EcgTrace from './EcgTrace.astro';

const channels = [
  { label: 'Email', value: profile.email, href: `mailto:${profile.email}` },
  { label: 'LinkedIn', value: '/in/sseman', href: profile.links.linkedin },
  { label: 'GitHub', value: '@ManSe404', href: profile.links.github },
];
---

<section class="section contact" id="contact">
  <div class="wrap">
    <div class="contact-card" data-reveal>
      <EcgTrace height={72} class="contact-ecg" />

      <div class="contact-body">
        <p class="eyebrow">Get in touch</p>
        <h2>Building something that needs to actually ship?</h2>
        <p class="contact-lede">
          I work on production AI systems — LLM and RAG architectures, document
          intelligence, and the cloud plumbing that keeps them running. Open to
          conversations about engineering work and research collaboration alike.
        </p>

        <ul class="contact-channels">
          {channels.map((channel) => (
            <li>
              <span class="channel-label mono">{channel.label}</span>
              <a
                href={channel.href}
                target={channel.href.startsWith('mailto:') ? undefined : '_blank'}
                rel="noopener noreferrer"
              >
                {channel.value}
              </a>
            </li>
          ))}
        </ul>

        <div class="contact-actions">
          <a class="btn" href={`mailto:${profile.email}`}>Send an email</a>
          <a class="btn btn-ghost" href={withBase(profile.cv)} download>Download CV</a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .contact-card {
    position: relative;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background:
      radial-gradient(38rem 20rem at 15% 0%, rgba(var(--bio-rgb), 0.10), transparent 65%),
      radial-gradient(34rem 18rem at 88% 100%, rgba(var(--ai-rgb), 0.09), transparent 62%),
      var(--surface);
    overflow: hidden;
  }

  .contact-ecg {
    opacity: 0.5;
  }

  .contact-body {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    padding: clamp(1.75rem, 4vw, 3rem);
    padding-top: clamp(0.5rem, 1vw, 1rem);
  }

  .contact-lede {
    color: var(--text-dim);
    max-width: 58ch;
  }

  .contact-channels {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    gap: 1rem;
    padding-block: 0.6rem;
    border-block: 1px solid var(--border);
  }

  .contact-channels li {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .channel-label {
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .contact-channels a {
    color: var(--text);
    font-size: 0.95rem;
    transition: color 0.25s var(--ease);
    overflow-wrap: anywhere;
  }

  .contact-channels a:hover {
    color: var(--bio);
  }

  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 0.3rem;
  }
</style>
