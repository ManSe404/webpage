---
import { withBase } from '../lib/url';
import { attribution, projectResult } from '../lib/dashboard';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
  // The big card: role and employer, a Result box, four stack items. Used for
  // Selected work on the home page.
  featured?: boolean;
  // Strips the card back to category, title, org, and summary, for a long list
  // where full cards would be more than anyone reads.
  compact?: boolean;
}

const { project, featured = false, compact = false } = Astro.props;
const { title, category, summary, stack, metrics } = project.data;

// "404 Solutions · with Provectus" — the partner only appears when there is one.
const employer = attribution(project);

// Big card only: the role comes from a metric labelled Role, the result line
// from the Result metric or, failing that, the first impact line.
const role = featured ? metrics.find((m) => m.label === 'Role')?.value : undefined;
const result = featured ? projectResult(project) : undefined;

// Show the leading stack items only; the full list lives on the detail page.
const shownStack = stack.slice(0, featured ? 4 : 5);
const overflow = stack.length - shownStack.length;
---

{featured ? (
  <a class="project card card-link is-featured" href={withBase(`/projects/${project.id}`)} data-reveal>
    <span class="chip chip-ai project-category">{category}</span>

    {(role || employer) && (
      <p class="project-byline mono">
        {role && <span class="project-byline-part project-role">{role}{employer && ' ·'}</span>}
        {role && employer && ' '}
        {employer && <span class="project-byline-part">{employer}</span>}
      </p>
    )}

    <h3 class="project-title">{title}</h3>

    {result && (
      <div class="project-result">
        <span class="project-result-label mono">Result</span>
        <p class="project-result-text">{result}</p>
      </div>
    )}

    <p class="project-summary">{summary}</p>

    {shownStack.length > 0 && (
      <div class="chips project-stack">
        {shownStack.map((tech) => (
          <span class="chip">{tech}</span>
        ))}
        {overflow > 0 && <span class="project-stack-more mono">+{overflow}</span>}
      </div>
    )}

    <span class="project-cta mono" aria-hidden="true">Read case study →</span>
  </a>
) : (
  <a
    class={`project card card-link ${compact ? 'is-compact' : ''}`}
    href={withBase(`/projects/${project.id}`)}
    data-reveal
  >
    <div class="project-top">
      <span class="chip chip-ai">{category}</span>
    </div>

    <h3 class="project-title">{title}</h3>
    {employer && <p class="project-org mono">{employer}</p>}
    <p class="project-summary">{summary}</p>

    {!compact && (
      <div class="chips project-stack">
        {shownStack.map((tech) => (
          <span class="chip">{tech}</span>
        ))}
        {overflow > 0 && <span class="chip">+{overflow}</span>}
      </div>
    )}

    <span class="project-cta mono" aria-hidden="true">
      {compact ? 'Read →' : 'Read case study →'}
    </span>
  </a>
)}

<style>
  .project {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    height: 100%;
    min-width: 0;
  }

  /* The global chip is 0.71rem; nothing on a card goes below 12 px. */
  .project .chip {
    font-size: 0.75rem;
  }

  .project-top {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .project-title {
    line-height: 1.25;
  }

  .project-org {
    font-size: 0.75rem;
    color: var(--bio);
    letter-spacing: 0.04em;
    margin-top: -0.45rem;
  }

  .project-summary {
    color: var(--text-dim);
    font-size: 0.95rem;
    flex-grow: 1;
  }

  .project-stack {
    margin-top: 0.15rem;
  }

  .project-cta {
    font-size: 0.76rem;
    color: var(--text-faint);
    transition: color 0.3s var(--ease), transform 0.3s var(--ease);
  }

  .project:hover .project-cta {
    color: var(--bio);
    transform: translateX(3px);
  }

  /* Compact cards carry summary only, so they need less internal rhythm. */
  .is-compact {
    gap: 0.55rem;
  }

  .is-compact .project-title {
    font-size: 1.05rem;
  }

  .is-compact .project-summary {
    font-size: 0.87rem;
  }

  .is-compact .project-org {
    margin-top: -0.3rem;
  }

  /* ---- The big card ------------------------------------------------------
     Reads top to bottom: what kind of work, who did it for whom, what it is,
     what it achieved, how, with what. */

  .is-featured {
    gap: 1rem;
  }

  .project-category {
    align-self: flex-start;
  }

  /* Role and employer each stay on one line where they fit, so a narrow card
     breaks the line between them rather than inside one. */
  .project-byline {
    font-size: 0.75rem;
    letter-spacing: 0.03em;
    line-height: 1.5;
    color: var(--text-dim);
    margin-top: -0.35rem;
  }

  .project-byline-part {
    display: inline-block;
    max-width: 100%;
  }

  .project-role {
    color: var(--text);
  }

  .is-featured .project-title {
    font-size: clamp(1.3rem, 2.4vw, 1.65rem);
    margin-top: -0.2rem;
  }

  .project-result {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 0.9rem 1rem;
    background: var(--bg);
    border: 1px solid var(--border);
    border-left: 2px solid var(--bio);
    border-radius: var(--radius-sm);
  }

  .project-result-label {
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--bio);
  }

  .project-result-text {
    font-size: 1.02rem;
    line-height: 1.45;
    color: var(--text);
  }

  .is-featured .project-stack {
    align-items: center;
    margin-top: 0;
  }

  .is-featured .project-stack .chip {
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .project-stack-more {
    font-size: 0.75rem;
    color: var(--text-dim);
    padding-inline: 0.2rem;
  }

  .is-featured .project-cta {
    font-size: 0.8rem;
    color: var(--bio);
  }

  .is-featured:hover .project-cta {
    color: var(--bio-bright);
  }

  @media (prefers-reduced-motion: reduce) {
    .project:hover .project-cta {
      transform: none;
    }
  }
</style>
