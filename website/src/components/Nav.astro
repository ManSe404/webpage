---
import profile from '../data/profile.json';
import { withBase } from '../lib/url';
import { LAB_DEMOS } from '../lib/lab';

// Pages and home-page sections, in the order the home page tells the story.
// `page` marks a link that owns a route, so it can be highlighted while you
// are on it. `sub` opens a dropdown on wide screens and shows indented in the
// phone menu; the parent link still goes to its page.
type Link = { label: string; href: string; page: boolean; sub?: { label: string; href: string }[] };
const links: Link[] = [
  { label: 'Projects', href: withBase('/projects'), page: true },
  { label: 'Research', href: withBase('/research'), page: true },
  {
    label: 'Lab', href: withBase('/lab'), page: true,
    sub: LAB_DEMOS.map((d) => ({ label: d.label, href: `${withBase('/lab/')}#${d.hash}` })),
  },
  { label: 'Contact', href: withBase('/#contact'), page: false },
];

const here = Astro.url.pathname.replace(/\/$/, '');
const isCurrent = (link: (typeof links)[number]) =>
  link.page && (here === link.href || here.startsWith(`${link.href}/`));

const social = [
  { label: 'in', title: 'LinkedIn', href: profile.links.linkedin },
  { label: 'gh', title: 'GitHub', href: profile.links.github },
  { label: 'gs', title: 'Google Scholar', href: profile.links.scholar },
];
---

<header class="nav" data-nav>
  <div class="nav-inner wrap">
    <a class="brand" href={withBase('/')}>
      <span class="brand-pulse" aria-hidden="true"></span>
      <span class="brand-name">{profile.name}</span>
    </a>

    <button class="nav-toggle" aria-label="Toggle navigation" aria-expanded="false" data-nav-toggle>
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
    </button>

    <nav class="nav-menu" data-nav-menu>
      <ul class="nav-links">
        {links.map((link) => (
          <li class={link.sub ? 'has-sub' : undefined}>
            <a href={link.href} aria-current={isCurrent(link) ? 'page' : undefined}>
              {link.label}{link.sub && <span class="caret" aria-hidden="true">▾</span>}
            </a>
            {link.sub && (
              <ul class="nav-sub" aria-label={`${link.label} pages`}>
                {link.sub.map((s) => <li><a href={s.href}>{s.label}</a></li>)}
              </ul>
            )}
          </li>
        ))}
      </ul>
      <a class="nav-cv" href={withBase(profile.cv)} download>
        CV <span aria-hidden="true">↓</span>
      </a>
      <ul class="nav-social">
        {social.map((item) => (
          <li>
            <a href={item.href} target="_blank" rel="noopener noreferrer" title={item.title}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<script>
  const nav = document.querySelector<HTMLElement>('[data-nav]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-nav-menu]');

  // Solidify the bar once the hero has scrolled behind it.
  if (nav) {
    const onScroll = () => nav.classList.toggle('is-stuck', window.scrollY > 40);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }

  if (toggle && menu) {
    toggle.addEventListener('click', () => {
      const open = menu.classList.toggle('is-open');
      toggle.classList.toggle('is-open', open);
      toggle.setAttribute('aria-expanded', String(open));
    });

    // Any navigation closes the mobile drawer.
    menu.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a')) {
        menu.classList.remove('is-open');
        toggle.classList.remove('is-open');
        toggle.setAttribute('aria-expanded', 'false');
      }
    });
  }
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    transition: background 0.4s var(--ease), border-color 0.4s var(--ease),
      backdrop-filter 0.4s var(--ease);
    border-bottom: 1px solid transparent;
  }

  .nav.is-stuck {
    background: rgba(var(--bg-rgb), 0.82);
    backdrop-filter: blur(14px);
    border-bottom-color: var(--border);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 1rem;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: -0.02em;
    font-size: 1.02rem;
    flex-shrink: 0;
  }

  /* A slow heartbeat next to the name — the smallest possible nod to the
     biosignal theme, present on every page. */
  .brand-pulse {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--bio);
    box-shadow: 0 0 10px var(--glow-bio);
    animation: heartbeat 2.4s var(--ease) infinite;
  }

  @keyframes heartbeat {
    0%, 62%, 100% { transform: scale(1); opacity: 1; }
    12% { transform: scale(1.75); opacity: 0.75; }
    24% { transform: scale(1); opacity: 1; }
    36% { transform: scale(1.4); opacity: 0.85; }
  }

  .nav-menu {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .nav-links {
    display: flex;
    gap: 1.6rem;
  }

  .nav-links a {
    font-size: 0.9rem;
    white-space: nowrap;
    color: var(--text-dim);
    position: relative;
    transition: color 0.25s var(--ease);
  }

  .nav-links a::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -5px;
    width: 100%;
    height: 1px;
    background: var(--bio);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s var(--ease);
  }

  .nav-links a:hover {
    color: var(--text);
  }

  .nav-links a:hover::after,
  .nav-links a[aria-current='page']::after {
    transform: scaleX(1);
  }

  .nav-links a[aria-current='page'] {
    color: var(--text);
  }

  /* The Lab dropdown: shown on hover or keyboard focus, no script needed. */
  .has-sub { position: relative; }
  .caret { margin-left: 0.3rem; font-size: 0.7em; color: var(--text-faint); }
  .nav-sub {
    position: absolute; top: calc(100% + 0.75rem); left: -0.8rem; min-width: 12rem;
    list-style: none; margin: 0; padding: 0.4rem; display: grid; gap: 0.1rem;
    background: rgba(var(--bg-rgb), 0.97); border: 1px solid var(--border); border-radius: var(--radius-sm);
    box-shadow: 0 14px 34px rgba(0, 0, 0, 0.4);
    opacity: 0; visibility: hidden; transform: translateY(-4px);
    transition: opacity 0.2s var(--ease), transform 0.2s var(--ease), visibility 0.2s;
  }
  /* A bridge over the gap, so the pointer can travel from the link to the list. */
  .nav-sub::before { content: ''; position: absolute; left: 0; right: 0; top: -0.8rem; height: 0.8rem; }
  .has-sub:hover .nav-sub, .has-sub:focus-within .nav-sub { opacity: 1; visibility: visible; transform: none; }
  .nav-links .nav-sub a { display: block; padding: 0.5rem 0.75rem; border-radius: 6px; font-size: 0.88rem; }
  .nav-links .nav-sub a::after { display: none; }
  .nav-links .nav-sub a:hover, .nav-links .nav-sub a:focus-visible { color: var(--text); background: var(--surface-hover); }

  .nav-cv {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    letter-spacing: 0.06em;
    padding: 0.4rem 0.8rem;
    border: 1px solid rgba(var(--bio-rgb), 0.55);
    border-radius: var(--radius-sm);
    background: rgba(var(--bio-rgb), 0.1);
    color: var(--bio);
    transition: background 0.28s var(--ease), box-shadow 0.28s var(--ease);
  }

  .nav-cv:hover {
    background: rgba(var(--bio-rgb), 0.18);
    box-shadow: 0 0 16px -4px var(--glow-bio);
  }

  .nav-social {
    display: flex;
    gap: 0.5rem;
  }

  .nav-social a {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-dim);
    transition: all 0.28s var(--ease);
  }

  .nav-social a:hover {
    color: var(--bio);
    border-color: var(--bio);
    box-shadow: 0 0 16px -4px var(--glow-bio);
  }

  .nav-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    padding: 0.5rem;
  }

  .nav-toggle span {
    display: block;
    width: 22px;
    height: 1.5px;
    background: var(--text);
    transition: transform 0.3s var(--ease), opacity 0.3s var(--ease);
  }

  .nav-toggle.is-open span:first-child {
    transform: translateY(3.25px) rotate(45deg);
  }

  .nav-toggle.is-open span:last-child {
    transform: translateY(-3.25px) rotate(-45deg);
  }

  @media (max-width: 1040px) {
    .nav-toggle {
      display: flex;
    }

    .nav-menu {
      position: absolute;
      inset-inline: 0;
      top: 100%;
      flex-direction: column;
      align-items: flex-start;
      gap: 1.5rem;
      padding: 1.75rem var(--gutter) 2.25rem;
      background: rgba(var(--bg-rgb), 0.97);
      backdrop-filter: blur(14px);
      border-bottom: 1px solid var(--border);
      clip-path: inset(0 0 100% 0);
      opacity: 0;
      pointer-events: none;
      transition: clip-path 0.4s var(--ease), opacity 0.3s var(--ease);
    }

    .nav-menu.is-open {
      clip-path: inset(0 0 0 0);
      opacity: 1;
      pointer-events: auto;
    }

    .nav-links {
      flex-direction: column;
      gap: 1.1rem;
    }

    .nav-links a {
      font-size: 1.05rem;
      color: var(--text);
    }

    /* In the phone menu the lab demos sit indented under Lab. */
    .caret { display: none; }
    .nav-sub {
      position: static; min-width: 0; padding: 0.55rem 0 0 1rem; gap: 0.5rem;
      background: none; border: 0; box-shadow: none; opacity: 1; visibility: visible; transform: none;
    }
    .nav-sub::before { display: none; }
    .nav-links .nav-sub a { padding: 0; font-size: 0.95rem; color: var(--text-dim); }
  }
</style>
