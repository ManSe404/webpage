---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProjectHive from '../../components/hive/ProjectHive.astro';
import { workType } from '../../lib/dashboard';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const total = projects.length;

// One big honeycomb, the projects of one field next to each other so the
// colours cluster: AI first, then data and analytics, then the rest; by order
// inside each field.
const FIELDS = [
  ['Generative AI', 'Agentic AI', 'Conversational AI', 'Computer Vision'],
  ['Data Engineering', 'Machine Learning'],
];
const fieldRank = (category: string) => {
  const i = FIELDS.findIndex((f) => f.includes(category));
  return i === -1 ? FIELDS.length : i;
};
const ordered = [...projects].sort((a, b) => fieldRank(a.data.category) - fieldRank(b.data.category) || a.data.order - b.data.order);

// Type of work follows who the work was for: own projects, the research
// institute, and everything delivered for an employer or a client.
const TYPES = [
  { id: 'all', label: 'All' },
  { id: 'client', label: 'Client work' },
  { id: 'research', label: 'Research' },
  { id: 'personal', label: 'Personal & open source' },
].map((t) => ({ ...t, count: t.id === 'all' ? total : projects.filter((p) => workType(p.data.org) === t.id).length }));

// Field follows the category, in the same three groups as the honeycomb's colours.
const fieldOf = (category: string) => ['ai', 'data'][fieldRank(category)] ?? 'software';
const FIELD_FILTERS = [
  { id: 'all', label: 'All' },
  { id: 'ai', label: 'AI systems' },
  { id: 'data', label: 'Data & analytics' },
  { id: 'software', label: 'Software & research' },
].map((f) => ({ ...f, count: f.id === 'all' ? total : projects.filter((p) => fieldOf(p.data.category) === f.id).length }));
---

<Base
  title="Projects — Stefan Seman"
  description="Production AI systems, data platforms, and research tooling built by Stefan Seman."
>
  <section class="page-head section">
    <div class="wrap">
      <p class="eyebrow">Portfolio</p>
      <h1 class="page-title">Projects</h1>
      <p class="page-lede">
        {total} systems across generative AI, document intelligence, data engineering, and
        biomedical research. Pick a cell to read what it is, what it achieved, my role, the
        tools and who it was for.
      </p>
    </div>
  </section>

  <section class="section projects-section" aria-label="Projects by field" data-projects>
    <div class="wrap">
      <div class="filters" data-filters hidden>
        <div class="types" role="group" aria-label="Filter by field">
          <span class="filter-label mono">Field</span>
          {FIELD_FILTERS.map((f, i) => (
            <button class="type mono" type="button" data-filter="field" data-value={f.id} aria-pressed={i === 0 ? 'true' : 'false'}>
              {f.label} <span class="type-count" data-count>{f.count}</span>
            </button>
          ))}
        </div>
        <div class="types" role="group" aria-label="Filter by type of work">
          <span class="filter-label mono">Type of work</span>
          {TYPES.map((t, i) => (
            <button class="type mono" type="button" data-filter="type" data-value={t.id} aria-pressed={i === 0 ? 'true' : 'false'}>
              {t.label} <span class="type-count" data-count>{t.count}</span>
            </button>
          ))}
        </div>
      </div>
      <p class="status mono" aria-live="polite" data-status></p>

      <p class="legend mono"><span class="dot dot-ai"></span>AI systems <span class="dot dot-data"></span>Data &amp; analytics <span class="dot dot-sw"></span>Software &amp; research</p>
      <ProjectHive id="p" projects={ordered} wide />
    </div>
  </section>
</Base>

<script>
  // Two filters that combine: field and type of work. Each button shows how many
  // projects it would leave with the other filter as it is.
  const root = document.querySelector<HTMLElement>('[data-projects]');
  const panel = root?.querySelector<HTMLElement>('[data-filters]');
  if (root && panel) {
    const buttons = [...panel.querySelectorAll<HTMLButtonElement>('[data-filter]')];
    const status = root.querySelector<HTMLElement>('[data-status]');
    const hive = root.querySelector<HTMLElement>('[data-phive]');
    const cells = [...root.querySelectorAll<HTMLElement>('li[data-type]')];
    const state: Record<string, string> = { field: 'all', type: 'all' };
    const fits = (li: HTMLElement, field: string, type: string) =>
      (field === 'all' || li.dataset.field === field) && (type === 'all' || li.dataset.type === type);
    panel.hidden = false;

    const apply = () => {
      let shown = 0;
      for (const li of cells) {
        li.hidden = !fits(li, state.field, state.type);
        if (!li.hidden) shown++;
      }
      hive?.dispatchEvent(new Event('phive:relayout'));
      for (const b of buttons) {
        const kind = b.dataset.filter === 'field' ? 'field' : 'type';
        const value = b.dataset.value ?? 'all';
        b.setAttribute('aria-pressed', String(state[kind] === value));
        const n = cells.filter((li) => fits(li, kind === 'field' ? value : state.field, kind === 'type' ? value : state.type)).length;
        const count = b.querySelector('[data-count]');
        if (count) count.textContent = String(n);
        b.classList.toggle('is-empty', n === 0);
      }
      if (status) {
        status.textContent = shown === cells.length ? `Showing all ${cells.length} projects`
          : shown === 0 ? 'No project matches both filters' : `Showing ${shown} of ${cells.length} projects`;
      }
    };

    for (const b of buttons) {
      b.addEventListener('click', () => { state[b.dataset.filter === 'field' ? 'field' : 'type'] = b.dataset.value ?? 'all'; apply(); });
    }
    apply();
  }
</script>

<style>
  .page-head { padding-top: 2.5rem; padding-bottom: 0; }
  /* The global eyebrow is 0.72rem; this page keeps every text at 12px or more. */
  .page-head .eyebrow { font-size: 0.75rem; }
  .page-title {
    font-size: clamp(2.4rem, 6vw, 4rem);
    margin-block: 0.6rem 0.85rem;
    background: linear-gradient(120deg, var(--text) 25%, var(--bio) 85%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .page-lede { color: var(--text-dim); max-width: 62ch; font-size: 1.03rem; }

  .projects-section { padding-top: clamp(1.5rem, 4vh, 2.75rem); }

  .filters { display: grid; gap: 0.7rem; }
  .filters[hidden] { display: none; }
  .types { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; }
  .filter-label { min-width: 7.5rem; font-size: 0.75rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-faint); }
  .type.is-empty:not([aria-pressed='true']) { opacity: 0.45; }
  .type {
    min-height: 36px; padding: 0 0.9rem; font-size: 0.8rem; color: var(--text-dim);
    background: var(--surface); border: 1px solid var(--border); border-radius: 999px; cursor: pointer;
  }
  .type[aria-pressed='true'] { color: var(--on-accent); background: var(--bio); border-color: var(--bio); }
  .type-count { margin-left: 0.3rem; opacity: 0.75; }
  @media (hover: hover) { .type:hover { border-color: var(--bio); color: var(--text); } .type[aria-pressed='true']:hover { color: var(--on-accent); } }
  .status { margin: 0.8rem 0 0; font-size: 0.75rem; color: var(--text-faint); }

  .legend { display: flex; justify-content: center; align-items: center; flex-wrap: wrap; gap: 0.5rem 1.2rem; margin: 1.6rem 0 1.2rem; font-size: 0.75rem; color: var(--text-dim); }
  .dot { display: inline-block; width: 10px; height: 10px; margin-right: 0.4rem; border-radius: 50%; vertical-align: middle; }
  .dot-ai { background: var(--ai); }
  .dot-data { background: var(--bio); }
  .dot-sw { background: var(--border-strong); border: 1px solid var(--text-dim); }

  @media (min-width: 720px) {
    .page-head { padding-top: clamp(3.5rem, 9vh, 6.5rem); }
  }
</style>
