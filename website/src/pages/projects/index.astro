---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProjectHive from '../../components/hive/ProjectHive.astro';
import { workType } from '../../lib/dashboard';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const total = projects.length;

// One honeycomb per field. A category not listed here falls into the last
// group, so a new category never makes a project disappear.
const GROUPS = [
  { id: 'ai', label: 'AI', topics: ['Generative AI', 'Agentic AI', 'Conversational AI', 'Computer Vision'] },
  { id: 'data', label: 'Data & analytics', topics: ['Data Engineering', 'Machine Learning'] },
  { id: 'software', label: 'Software & research', topics: [] as string[] },
];
const known = new Set(GROUPS.flatMap((g) => g.topics));
const groups = GROUPS.map((g, i) => ({
  ...g,
  projects: projects.filter((p) =>
    i === GROUPS.length - 1 ? !known.has(p.data.category) : g.topics.includes(p.data.category)),
})).filter((g) => g.projects.length);

// Type of work follows who the work was for: own projects, the research
// institute, and everything delivered for an employer or a client.
const TYPES = [
  { id: 'all', label: 'All' },
  { id: 'client', label: 'Client work' },
  { id: 'research', label: 'Research' },
  { id: 'personal', label: 'Personal & open source' },
].map((t) => ({ ...t, count: t.id === 'all' ? total : projects.filter((p) => workType(p.data.org) === t.id).length }));
---

<Base
  title="Projects — Stefan Seman"
  description="Production AI systems, data platforms, and research tooling built by Stefan Seman."
>
  <section class="page-head section">
    <div class="wrap">
      <p class="eyebrow">Portfolio</p>
      <h1 class="page-title">Projects</h1>
      <p class="page-lede">
        {total} systems across generative AI, document intelligence, data engineering, and
        biomedical research. Pick a cell to read what it is, what it achieved, my role, the
        tools and who it was for.
      </p>
    </div>
  </section>

  <section class="section projects-section" aria-label="Projects by field" data-projects>
    <div class="wrap">
      <div class="types" role="group" aria-label="Filter by type of work" data-types hidden>
        {TYPES.map((t, i) => (
          <button class="type mono" type="button" data-type={t.id} aria-pressed={i === 0 ? 'true' : 'false'}>
            {t.label} <span class="type-count">{t.count}</span>
          </button>
        ))}
      </div>
      <p class="status mono" aria-live="polite" data-status></p>

      {groups.map((g) => (
        <section class="group" data-group aria-labelledby={`group-${g.id}`}>
          <h2 class="group-title" id={`group-${g.id}`}>{g.label} <span class="group-count mono" data-group-count>{g.projects.length}</span></h2>
          <ProjectHive id={g.id} projects={g.projects} />
        </section>
      ))}
    </div>
  </section>
</Base>

<script>
  const root = document.querySelector<HTMLElement>('[data-projects]');
  const bar = root?.querySelector<HTMLElement>('[data-types]');
  if (root && bar) {
    const buttons = [...bar.querySelectorAll<HTMLButtonElement>('[data-type]')];
    const status = root.querySelector<HTMLElement>('[data-status]');
    const groups = [...root.querySelectorAll<HTMLElement>('[data-group]')];
    const total = root.querySelectorAll('[data-pcell]').length;
    bar.hidden = false;

    const apply = (type: string) => {
      let shown = 0;
      for (const g of groups) {
        const cells = [...g.querySelectorAll<HTMLElement>('li[data-type]')];
        let inGroup = 0;
        for (const li of cells) {
          li.hidden = type !== 'all' && li.dataset.type !== type;
          if (!li.hidden) inGroup++;
        }
        g.hidden = inGroup === 0;
        const count = g.querySelector('[data-group-count]');
        if (count) count.textContent = String(inGroup);
        g.querySelector('[data-phive]')?.dispatchEvent(new Event('phive:relayout'));
        shown += inGroup;
      }
      for (const b of buttons) b.setAttribute('aria-pressed', String(b.dataset.type === type));
      if (status) status.textContent = type === 'all' ? `Showing all ${total} projects` : `Showing ${shown} of ${total} projects`;
    };

    for (const b of buttons) b.addEventListener('click', () => apply(b.dataset.type ?? 'all'));
    apply('all');
  }
</script>

<style>
  .page-head { padding-top: 2.5rem; padding-bottom: 0; }
  /* The global eyebrow is 0.72rem; this page keeps every text at 12px or more. */
  .page-head .eyebrow { font-size: 0.75rem; }
  .page-title {
    font-size: clamp(2.4rem, 6vw, 4rem);
    margin-block: 0.6rem 0.85rem;
    background: linear-gradient(120deg, var(--text) 25%, var(--bio) 85%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .page-lede { color: var(--text-dim); max-width: 62ch; font-size: 1.03rem; }

  .projects-section { padding-top: clamp(1.5rem, 4vh, 2.75rem); }

  .types { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .types[hidden] { display: none; }
  .type {
    min-height: 36px; padding: 0 0.9rem; font-size: 0.8rem; color: var(--text-dim);
    background: var(--surface); border: 1px solid var(--border); border-radius: 999px; cursor: pointer;
  }
  .type[aria-pressed='true'] { color: var(--on-accent); background: var(--bio); border-color: var(--bio); }
  .type-count { margin-left: 0.3rem; opacity: 0.75; }
  @media (hover: hover) { .type:hover { border-color: var(--bio); color: var(--text); } .type[aria-pressed='true']:hover { color: var(--on-accent); } }
  .status { margin: 0.8rem 0 0; font-size: 0.75rem; color: var(--text-faint); }

  .group { margin-top: clamp(2rem, 5vh, 3rem); }
  .group[hidden] { display: none; }
  .group-title { margin: 0 0 1.2rem; font-size: clamp(1.3rem, 2.4vw, 1.7rem); }
  .group-count { margin-left: 0.4rem; font-size: 0.8rem; color: var(--bio); vertical-align: middle; }

  @media (min-width: 720px) {
    .page-head { padding-top: clamp(3.5rem, 9vh, 6.5rem); }
  }
</style>
