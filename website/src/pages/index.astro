---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import HiveDashboard from '../components/hive/HiveDashboard.astro';
import Section from '../components/Section.astro';
import ProjectHive from '../components/hive/ProjectHive.astro';
import Lab from '../components/lab/Lab.astro';
import Contact from '../components/Contact.astro';
import { withBase } from '../lib/url';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);

// One honeycomb of chosen work: the first five AI projects and the first
// three data projects by order, AI in ember and data in honey. /projects/
// shows all of them.
const AI_TOPICS = new Set(['Generative AI', 'Agentic AI', 'Conversational AI', 'Computer Vision']);
const DATA_TOPICS = new Set(['Data Engineering', 'Machine Learning']);
const chosen = [
  ...projects.filter((p) => AI_TOPICS.has(p.data.category)).slice(0, 5),
  ...projects.filter((p) => DATA_TOPICS.has(p.data.category)).slice(0, 3),
].sort((a, b) => a.data.order - b.data.order);
---

<Base>
  <HiveDashboard />

  <Section
    id="work"
    eyebrow="Chosen work"
    title="Systems first."
    lede="AI systems and data platforms taken from problem statement to something running, monitored and maintained. Pick a cell to read what it is, what it achieved, my role, the tools and who it was for."
  >
    <p class="legend mono"><span class="dot dot-ai"></span>AI systems <span class="dot dot-data"></span>Data &amp; analytics</p>
    <ProjectHive id="work" projects={chosen} />
    <div class="section-cta" data-reveal>
      <a class="btn btn-ghost" href={withBase('/projects/')}>All {projects.length} projects <span aria-hidden="true">→</span></a>
    </div>
  </Section>

  <Section
    id="lab"
    eyebrow="Lab"
    title="See it work."
    lede="Two small demos that run in your browser: a synthetic biosignal cleaned step by step, and how the data platforms and AI systems I build fit together. Every number and row here is synthetic."
  >
    <Lab />
  </Section>

  <Contact />
</Base>

<style>
  .legend { display: flex; justify-content: center; align-items: center; gap: 0.5rem 1.2rem; flex-wrap: wrap; margin: -0.5rem 0 1.2rem; font-size: 0.75rem; color: var(--text-dim); }
  .dot { display: inline-block; width: 10px; height: 10px; margin-right: 0.4rem; border-radius: 50%; vertical-align: middle; }
  .dot-ai { background: var(--ai); }
  .dot-data { background: var(--bio); }

  .section-cta {
    display: flex;
    justify-content: center;
    margin-top: 2.25rem;
  }
</style>
