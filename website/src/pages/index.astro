---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import HiveDashboard from '../components/hive/HiveDashboard.astro';
import Section from '../components/Section.astro';
import ProjectHive from '../components/hive/ProjectHive.astro';
import { withBase } from '../lib/url';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);

// Chosen work: the projects with a `home` rank, in that order (strongest
// first, client work only, set by hand in each project file). /projects/
// shows all of them.
const chosen = projects.filter((p) => p.data.home).sort((a, b) => (a.data.home ?? 0) - (b.data.home ?? 0));
---

<Base>
  <HiveDashboard />

  <Section
    id="work"
    eyebrow="Chosen work"
    title="Systems first."
    lede="AI systems and data platforms taken from problem statement to something running, monitored and maintained. Pick a cell to read what it is, what it achieved, my role, the tools and who it was for."
  >
    <p class="legend mono"><span class="dot dot-ai"></span>AI systems <span class="dot dot-data"></span>Data &amp; analytics</p>
    <ProjectHive id="work" projects={chosen} />
    <div class="section-cta" data-reveal>
      <a class="btn btn-ghost" href={withBase('/projects/')}>All {projects.length} projects <span aria-hidden="true">→</span></a>
    </div>
  </Section>

</Base>

<style>
  .legend { display: flex; justify-content: center; align-items: center; gap: 0.5rem 1.2rem; flex-wrap: wrap; margin: -0.5rem 0 1.2rem; font-size: 0.75rem; color: var(--text-dim); }
  .dot { display: inline-block; width: 10px; height: 10px; margin-right: 0.4rem; border-radius: 50%; vertical-align: middle; }
  .dot-ai { background: var(--ai); }
  .dot-data { background: var(--bio); }

  .section-cta {
    display: flex;
    justify-content: center;
    margin-top: 2.25rem;
  }
</style>
